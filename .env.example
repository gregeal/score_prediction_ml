FOOTBALL_DATA_API_KEY=your_api_key_here
# SQLite works without Docker. For PostgreSQL set a URL with your own credentials.
DATABASE_URL=sqlite:///./predictepl.db
MLFLOW_TRACKING_URI=
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://gregeal.github.io
POSTGRES_USER=predictepl
# Required only for Docker/PostgreSQL. Set a long random password before starting.
POSTGRES_PASSWORD=
POSTGRES_DB=predictepl
