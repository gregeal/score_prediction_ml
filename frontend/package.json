{
  "name": "predictepl-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22", "npm": ">=10" },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
